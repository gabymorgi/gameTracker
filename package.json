{
  "name": "game-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#prisma-client": "./prisma/client.ts",
    "#prisma-generated-client": "./prisma/generated/client.ts",
    "#prisma-browser-client": "./prisma/generated/browser.ts"
  },
  "scripts": {
    "start": "netlify dev",
    "dev": "vite",
    "build": "tsc && vite build",
    "postinstall": "npx prisma generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:seed": "tsx prisma/seed.ts",
    "db:deploy:prod": "cross-env PRISMA_ENV=production prisma migrate deploy",
    "scripts": "bun --env-file=.env ./scripts/main.ts",
    "lint": "npm run lint:types && npm run lint:code",
    "lint:types": "npm run lint:types:app && npm run lint:types:netlify && npm run lint:types:scripts",
    "lint:types:app": "tsc --noEmit",
    "lint:types:netlify": "tsc --noEmit -p tsconfig.netlify.json",
    "lint:types:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "lint:code": "eslint . --max-warnings 10",
    "lint:unused-exports": "knip",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "overrides": {
    "@opentelemetry/api": "^1.8.0"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@netlify/functions": "^6.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "antd": "^6.6.6",
    "chart.js": "^4.5.1",
    "d3": "^7.9.0",
    "d3-color": "^3.1.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.8",
    "jsonwebtoken": "^9.0.1",
    "jwt-decode": "^4.0.0",
    "node-fetch": "^3.3.2",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-intersection-observer": "^11.0.1",
    "react-router-dom": "^7.18.4",
    "styled-components": "^6.6.0",
    "use-query-params": "^2.2.2",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@eslint/js": "^10.0.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3": "^7.4.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.9",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "knip": "^6.41.0",
    "netlify-cli": "^27.12.1",
    "papaparse": "^5.7.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  }
}
